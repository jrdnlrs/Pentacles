<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/timeline_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:background="#E2E8F0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/timeline_icon_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_circle_white"
        android:elevation="2dp"
        android:padding="6dp"
        android:src="@drawable/outline_shield_24"
        app:tint="#64748B"
        app:layout_constraintStart_toStartOf="@+id/timeline_line"
        app:layout_constraintEnd_toEndOf="@+id/timeline_line"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_event"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        app:cardBackgroundColor="#F8FAFC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/timeline_icon_bg"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_event_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Event Title"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/badge_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_neutral_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/text_event_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description goes here"
                android:textSize="13sp"
                android:textColor="#334155"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_timestamp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="2024-01-01 12:00"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"/>
                <TextView
                    android:id="@+id/text_ssid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi_Name"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_white_stroke"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Technical Details:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/text_tech_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detail 1"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#475569"/>
                <TextView
                    android:id="@+id/text_tech_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detail 2"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#475569"/>
                <TextView
                    android:id="@+id/text_tech_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detail 3"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#475569"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>