<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:id="@+id/card_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp"
        android:minHeight="100dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/metric_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wifi"
                app:tint="@color/networks_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/metric_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/networks"
                android:textSize="13sp"
                android:textColor="@color/gray_600" />

            <TextView
                android:id="@+id/metric_value_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/metric_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_scan"
                android:textSize="11sp"
                android:textColor="@color/gray_500" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>