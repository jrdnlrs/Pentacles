                        <TextView android:text="3" android:textColor="@color/white" android:background="@drawable/learn_bg_circle_number" android:gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Orange/Yellow = Warning/Suspicious activity" android:layout_marginStart="12dp" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:text="4" android:textColor="@color/white" android:background="@drawable/learn_bg_circle_number" android:gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Red gradient = Danger/Evil Twin detected" android:layout_marginStart="12dp" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:text="5" android:textColor="@color/white" android:background="@drawable/learn_bg_circle_number" android:gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Tignan ang status cards sa dashboard para sa quick overview" android:layout_marginStart="12dp" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:text="6" android:textColor="@color/white" android:background="@drawable/learn_bg_circle_number" android:gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="I-tap ang mga cards para sa detailed information" android:layout_marginStart="12dp" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
