                        <TextView android:text="Green gradient = Secure/Safe na network" android:layout_marginStart="12dp" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:text="2" android:textColor="@color/white" android:background="@drawable/learn_bg_circle_number" android:gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:text="Blue gradient = Normal/Trusted network" android:layout_marginStart="12dp" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
